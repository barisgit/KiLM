{
  "name": "kilm-docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "sync-docs": "tsx scripts/sync-embedded-docs.ts sync",
    "sync-docs:watch": "tsx scripts/sync-embedded-docs.ts watch",
    "sync-docs:clean": "tsx scripts/sync-embedded-docs.ts clean",
    "dev": "concurrently \"pnpm sync-docs:watch\" \"astro dev\" --names \"sync,astro\" --prefix-colors \"blue,green\"",
    "start": "pnpm dev",
    "build": "pnpm sync-docs && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  }
}
